---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,JPG,JPEG}",
  { eager: true }
);

const all = Object.values(modules);

// 横長(幅 > 高さ)と縦長(高さ >= 幅)に分ける
const landscape = await Promise.all(
  all
    .filter((mod) => mod.default.width > mod.default.height)
    .map(async (mod) => (await getImage({ src: mod.default, width: 2400 })).src)
);

const portrait = await Promise.all(
  all
    .filter((mod) => mod.default.width <= mod.default.height)
    .map(async (mod) => (await getImage({ src: mod.default, width: 1400 })).src)
);
---

<Layout>
  <div
    class="show"
    data-landscape={JSON.stringify(landscape)}
    data-portrait={JSON.stringify(portrait)}
  >
    <div class="layer"></div>
    <div class="layer"></div>
  </div>
</Layout>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  /* iOS 26 Safari は body の背景色で上下バーの色を決める。
     写真の平均色(--tint)をここに入れて、バーを写真に馴染ませる */
  html,
  html body {
    background-color: var(--tint, #000);
    transition: background-color 2s ease;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    color: #fff;
    mix-blend-mode: difference;
    --fg: #fff;
    --muted: #fff;
  }
</style>

<style>
  .show {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh; /* フォールバック */
    height: 100lvh;
    overflow: hidden;
  }

  .layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 2s ease;
  }

  .layer.visible {
    opacity: 1;
  }
</style>

<script>
  // 切り替わる間隔(ミリ秒)。15000 = 15秒
  const INTERVAL = 15000;

  const root = document.querySelector<HTMLElement>(".show");

  if (root) {
    const landscape: string[] = JSON.parse(root.dataset.landscape ?? "[]");
    const portrait: string[] = JSON.parse(root.dataset.portrait ?? "[]");
    const layers = Array.from(root.querySelectorAll<HTMLElement>(".layer"));
    const media = window.matchMedia("(max-aspect-ratio: 1/1)");

    let timer: number | undefined;

    const shuffle = (list: string[]) => {
      const a = [...list];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    const setImage = (el: HTMLElement, src: string) => {
      el.style.backgroundImage = `url("${src}")`;
    };

    // 写真の平均色を求めて、背景色(--tint)に設定する
    const tint = (src: string) => {
      const img = new Image();
      img.onload = () => {
        try {
          const size = 8;
          const canvas = document.createElement("canvas");
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext("2d");
          if (!ctx) return;
          ctx.drawImage(img, 0, 0, size, size);
          const data = ctx.getImageData(0, 0, size, size).data;
          let r = 0;
          let g = 0;
          let b = 0;
          const n = data.length / 4;
          for (let i = 0; i < data.length; i += 4) {
            r += data[i];
            g += data[i + 1];
            b += data[i + 2];
          }
          document.documentElement.style.setProperty(
            "--tint",
            `rgb(${Math.round(r / n)}, ${Math.round(g / n)}, ${Math.round(b / n)})`
          );
        } catch {}
      };
      img.src = src;
    };

    const start = () => {
      window.clearInterval(timer);
      layers.forEach((l) => l.classList.remove("visible"));

      // 縦長の画面なら縦長の写真、横長の画面なら横長の写真。なければもう片方を使う
      const wanted = media.matches ? portrait : landscape;
      const fallback = media.matches ? landscape : portrait;
      const order = shuffle(wanted.length > 0 ? wanted : fallback);
      if (order.length === 0) return;

      let current = 0;
      let front = 0;

      setImage(layers[0], order[0]);
      layers[0].classList.add("visible");
      tint(order[0]);

      if (order.length > 1) {
        timer = window.setInterval(() => {
          const next = (current + 1) % order.length;
          const back = 1 - front;
          const pre = new Image();
          pre.onload = () => {
            setImage(layers[back], order[next]);
            layers[front].classList.remove("visible");
            layers[back].classList.add("visible");
            tint(order[next]);
            front = back;
            current = next;
          };
          pre.src = order[next];
        }, INTERVAL);
      }
    };

    start();
    media.addEventListener("change", start);
  }
</script>