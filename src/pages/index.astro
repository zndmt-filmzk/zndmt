---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,JPG,JPEG}",
  { eager: true }
);

const all = Object.values(modules);

// 横長(幅 > 高さ)と縦長(高さ >= 幅)に分ける
const landscape = await Promise.all(
  all
    .filter((mod) => mod.default.width > mod.default.height)
    .map(async (mod) => (await getImage({ src: mod.default, width: 2400 })).src)
);

const portrait = await Promise.all(
  all
    .filter((mod) => mod.default.width <= mod.default.height)
    .map(async (mod) => (await getImage({ src: mod.default, width: 1400 })).src)
);
---

<Layout>
  <div
    class="show"
    data-landscape={JSON.stringify(landscape)}
    data-portrait={JSON.stringify(portrait)}
  >
    <img class="layer" alt="" />
    <img class="layer" alt="" />
  </div>
</Layout>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    background: #000;
    overflow: hidden;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    color: #fff;
    mix-blend-mode: difference;
    --fg: #fff;
    --muted: #fff;
  }
</style>

<style>
  /* 画面の四辺に固定し、上下はバー(セーフエリア)の分だけ外側まで広げる */
  .show {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) * -1);
    bottom: calc(env(safe-area-inset-bottom, 0px) * -1);
    left: 0;
    right: 0;
    overflow: hidden;
    z-index: 0;
  }

  /* img + object-fit: cover で、枠いっぱいに写真を拡大して埋める */
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 2s ease;
  }

  .layer.visible {
    opacity: 1;
  }
</style>

<script>
  // 切り替わる間隔(ミリ秒)。15000 = 15秒
  const INTERVAL = 15000;

  const root = document.querySelector<HTMLElement>(".show");

  if (root) {
    const landscape: string[] = JSON.parse(root.dataset.landscape ?? "[]");
    const portrait: string[] = JSON.parse(root.dataset.portrait ?? "[]");
    const layers = Array.from(root.querySelectorAll<HTMLImageElement>(".layer"));
    const media = window.matchMedia("(max-aspect-ratio: 1/1)");

    let timer: number | undefined;

    const shuffle = (list: string[]) => {
      const a = [...list];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    const start = () => {
      window.clearInterval(timer);
      layers.forEach((l) => l.classList.remove("visible"));

      // 縦長の画面なら縦長の写真、横長の画面なら横長の写真。なければもう片方を使う
      const wanted = media.matches ? portrait : landscape;
      const fallback = media.matches ? landscape : portrait;
      const order = shuffle(wanted.length > 0 ? wanted : fallback);
      if (order.length === 0) return;

      let current = 0;
      let front = 0;

      layers[0].src = order[0];
      layers[0].classList.add("visible");

      if (order.length > 1) {
        timer = window.setInterval(() => {
          const next = (current + 1) % order.length;
          const back = 1 - front;
          const pre = new Image();
          pre.onload = () => {
            layers[back].src = order[next];
            layers[front].classList.remove("visible");
            layers[back].classList.add("visible");
            front = back;
            current = next;
          };
          pre.src = order[next];
        }, INTERVAL);
      }
    };

    start();
    media.addEventListener("change", start);
  }
</script>