---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { photoTitles } from "../assets/photos/photoTitles";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,JPG,JPEG}",
  { eager: true }
);

const photos = await Promise.all(
  Object.entries(modules)
    .map(([path, mod]) => {
      const id = decodeURIComponent(path.split("/").pop()!).replace(/\.[^.]+$/, "");
      return { path, mod, id, num: Number(id) };
    })
    // 数字が大きいものを先頭に(降順)
    .sort((a, b) => b.num - a.num)
    .map(async ({ mod, id }) => {
      const title = photoTitles[id] ?? "";
      const full = await getImage({ src: mod.default, width: 2000 });
      return {
        src: mod.default,
        ratio: mod.default.width / mod.default.height,
        title,
        fullSrc: full.src,
      };
    })
);
---

<Layout title="Photo">
  <ul class="grid">
    {photos.map((photo) => (
      <li style={`--ratio: ${photo.ratio}`}>
        <button
          type="button"
          class="thumb"
          data-full={photo.fullSrc}
          data-title={photo.title}
          aria-label={photo.title ? `${photo.title} を拡大` : "写真を拡大"}
        >
          <Image
            src={photo.src}
            alt={photo.title}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 900px) 40vw, 60vw"
            loading="lazy"
          />
        </button>
      </li>
    ))}
    <li class="filler" aria-hidden="true"></li>
  </ul>

  <div id="lb" class="lb" role="dialog" aria-modal="true" aria-label="写真の拡大表示" aria-hidden="true">
    <figure class="lb-figure">
      <img id="lb-img" alt="" />
      <figcaption id="lb-title"></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-prev" data-lb="prev" aria-label="前の写真">‹</button>
    <button type="button" class="lb-btn lb-next" data-lb="next" aria-label="次の写真">›</button>
    <button type="button" class="lb-btn lb-close" data-lb="close" aria-label="閉じる">×</button>
  </div>
</Layout>

<script>
  const w = window as any;
  if (!w.__photoLightbox) {
    w.__photoLightbox = true;
    let current = 0;
    let token = 0; // 連打・素早い切り替え時に古い読み込みを無視するため

    const els = () => ({
      lb: document.getElementById("lb") as HTMLElement | null,
      figure: document.querySelector<HTMLElement>(".lb-figure"),
      img: document.getElementById("lb-img") as HTMLImageElement | null,
      cap: document.getElementById("lb-title") as HTMLElement | null,
      thumbs: Array.from(document.querySelectorAll<HTMLElement>(".thumb")),
    });

    // 画像のデコードが終わってから、画像とタイトルを一緒にフェードインする
    async function show(index: number) {
      const { figure, img, cap, thumbs } = els();
      if (!figure || !img || !cap || thumbs.length === 0) return;
      current = (index + thumbs.length) % thumbs.length;
      const t = thumbs[current];
      const my = ++token;

      // いったんフェードアウト
      figure.classList.remove("is-ready");

      const src = t.dataset.full ?? "";
      const title = t.dataset.title ?? "";

      // 読み込み+デコード完了を待つ
      const loader = new Image();
      loader.src = src;
      try {
        await loader.decode();
      } catch {
        // 失敗しても表示は続ける
      }
      if (my !== token) return; // 別の写真に切り替わっていたら中断

      img.src = src;
      img.alt = title;
      cap.textContent = title;
      cap.hidden = !title;

      // 次フレームでフェードイン
      requestAnimationFrame(() => {
        if (my === token) figure.classList.add("is-ready");
      });
    }

    function open(index: number) {
      const { lb } = els();
      if (!lb) return;
      lb.classList.add("is-open");
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      show(index);
    }

    function close() {
      const { lb, figure, img } = els();
      if (!lb) return;
      token++;
      lb.classList.remove("is-open");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      // フェードアウトが終わってから画像を外す
      setTimeout(() => {
        if (!lb.classList.contains("is-open")) {
          figure?.classList.remove("is-ready");
          img?.removeAttribute("src");
        }
      }, 400);
    }

    const isOpen = () => !!els().lb?.classList.contains("is-open");

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const thumb = target.closest<HTMLElement>(".thumb");
      if (thumb) {
        const { thumbs } = els();
        open(thumbs.indexOf(thumb));
        return;
      }

      if (!isOpen()) return;

      const action = target.closest<HTMLElement>("[data-lb]")?.dataset.lb;
      if (action === "close") close();
      else if (action === "prev") show(current - 1);
      else if (action === "next") show(current + 1);
      else if (!target.closest("#lb-img")) close(); // 写真以外(背景)をクリックで閉じる
    });

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    // ページ遷移(View Transitions)で離れたときに状態を戻す
    document.addEventListener("astro:before-swap", () => {
      document.body.style.overflow = "";
    });
  }
</script>

<style>
  .grid {
    --row: 220px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .grid {
      --row: 400px;
      gap: 24px;
    }
  }

  .grid li {
    flex-grow: calc(var(--ratio) * 100);
    flex-basis: calc(var(--ratio) * var(--row));
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .grid .filler {
    flex-grow: 100000;
    flex-basis: 0;
  }

  /* ---- Lightbox ---- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    color: var(--fg);
    cursor: zoom-out;
    /* 以下は変更なし */

    /* 背景は先にふわっと */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }

  .lb.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s ease, visibility 0s;
  }

  .lb-figure {
    margin: 0;
    padding: 56px 56px 24px;
    max-width: 100%;
    max-height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;

    /* 画像+タイトルは読み込み完了後にまとめてフェードイン */
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .lb-figure.is-ready {
    opacity: 1;
    transform: scale(1);
  }

  .lb-figure img {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: default;
  }

  .lb-figure figcaption {
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-align: center;
    min-height: 1.4em; /* タイトルなしでも高さを揃えて位置ズレを防ぐ */
  }

  .lb-btn {
    position: absolute;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    line-height: 1;
  }

  .lb-close {
    top: 12px;
    right: 20px;
    font-size: 2rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    padding: 0 16px;
  }

  .lb-prev { left: 4px; }
  .lb-next { right: 4px; }

  @media (max-width: 600px) {
    .lb-figure { padding: 56px 12px 16px; }
    .lb-prev, .lb-next { font-size: 2.2rem; padding: 0 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb, .lb-figure { transition-duration: 0.01s; }
  }
</style>