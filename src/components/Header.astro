---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;

const links = [
  { href: "/photo", label: "Photo" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

const isCurrent = (href: string) => pathname.startsWith(href);
---

<header>
  <a href="/" class="site-name">zndmt</a>
  <nav>
    {links.map((link) => (
      <a href={link.href} class:list={[{ current: isCurrent(link.href) }]}>
        {link.label}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 24px;
  }

  .site-name {
    font-size: 1.17rem; /* h3 相当 */
    font-weight: bold;
    color: var(--fg);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a {
    padding: 8px 0;
    color: var(--muted);
  }

  nav a.current {
    color: var(--fg);
  }
</style>