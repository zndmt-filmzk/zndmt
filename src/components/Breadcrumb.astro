---
interface Props {
  title?: string;
}

const { title } = Astro.props;

const labels: Record<string, string> = {
  blog: "Blog",
  photo: "Photo",
  about: "About",
};

const segments = Astro.url.pathname.split("/").filter(Boolean);

const items = [
  { label: "Home", href: "/" },
  ...segments.map((seg, i) => ({
    label: i === segments.length - 1 && title ? title : (labels[seg] ?? seg),
    href: "/" + segments.slice(0, i + 1).join("/"),
  })),
];
---

<nav aria-label="breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  nav {
    padding: 0 24px 24px;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  li + li::before {
    content: ">";
    margin-right: 8px;
    color: var(--muted);
  }

  a {
    color: var(--muted);
  }

  a:hover {
    color: var(--fg);
  }
</style>
