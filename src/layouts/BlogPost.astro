---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date)
  .toISOString()
  .slice(0, 10)
  .replaceAll("-", ".");

// 全記事を新しい順に並べて、自分の前後を探す
const modules = import.meta.glob<any>("../pages/blog/*.md", { eager: true });
const posts = Object.values(modules)
  .map((post) => ({
    url: post.url,
    title: post.frontmatter.title,
    date: new Date(post.frontmatter.date),
  }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const normalize = (u: string) => u.replace(/\/$/, "");
const index = posts.findIndex(
  (p) => normalize(p.url) === normalize(Astro.url.pathname)
);
const newer = index > 0 ? posts[index - 1] : undefined;
const older =
  index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
---

<Layout title={frontmatter.title}>
  <article>
    <h1>{frontmatter.title}</h1>
    <p class="date">{date}</p>
    <div class="body">
      <slot />
    </div>
    <nav class="pager" aria-label="前後の記事">
      <div class="prev">
        {newer && <a href={newer.url} rel="next">{`← ${newer.title}`}</a>}
      </div>
      <div class="next">
        {older && <a href={older.url} rel="prev">{`${older.title} →`}</a>}
      </div>
    </nav>
  </article>
</Layout>

<style>
  article {
    max-width: 960px;
    margin: 0 auto;
  }

  h1 {
    font-size: 1rem;
    font-weight: bold;
    margin: 24px 0 0;
  }

  .date {
    color: var(--muted);
    margin: 0 0 48px;
  }

  .body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 48px 0;
  }

  .body :global(p) {
    margin: 0 0 1.5em;
  }

  .pager {
    margin: 96px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .pager a {
    display: inline-block;
    padding: 8px 0;
    color: var(--muted);
  }

  .pager a:hover {
    color: var(--fg);
  }

  .next {
    text-align: right;
  }
</style>